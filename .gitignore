.env
.env.*
!.env.example
*.pem
*.key
*.cert

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# IDEs & editors
.idea/
.vscode/
*.swp
*.swo

# Playwright & test reports
.playwright/
test-results/

# SQLite temporary files
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Private research data and captures
data/research/

# Local credentials
credentials.json
client_secret*.json
